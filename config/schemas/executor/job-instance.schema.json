{
  "$defs": {
    "Backend": {
      "description": "Execution backend types.",
      "enum": [
        "cmd",
        "llm",
        "claude-code",
        "codex"
      ],
      "title": "Backend",
      "type": "string"
    },
    "Common": {
      "additionalProperties": false,
      "description": "Engine-enforced common block for all steps.\n\nThese fields are managed by the executor, not the backend.",
      "properties": {
        "repo_path": {
          "description": "Path to the target repository",
          "format": "path",
          "title": "Repo Path",
          "type": "string"
        },
        "branch": {
          "description": "Branch being worked on",
          "title": "Branch",
          "type": "string"
        },
        "base_commit": {
          "description": "SHA of the base commit",
          "title": "Base Commit",
          "type": "string"
        },
        "timeout_s": {
          "default": 300,
          "description": "Step timeout in seconds",
          "title": "Timeout S",
          "type": "integer"
        },
        "policy_profile": {
          "default": "default",
          "description": "Policy profile name",
          "title": "Policy Profile",
          "type": "string"
        }
      },
      "required": [
        "repo_path",
        "branch",
        "base_commit"
      ],
      "title": "Common",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "description": "A materialized step in a JobInstance.\n\nSteps are fully resolved - no @ref expressions remain.",
      "properties": {
        "step_n": {
          "description": "Step number (1-indexed)",
          "minimum": 1,
          "title": "Step N",
          "type": "integer"
        },
        "step_id": {
          "description": "Unique identifier for this step",
          "title": "Step Id",
          "type": "string"
        },
        "backend": {
          "$ref": "#/$defs/Backend",
          "description": "Execution backend"
        },
        "description": {
          "default": "",
          "description": "Human-readable description",
          "title": "Description",
          "type": "string"
        },
        "common": {
          "$ref": "#/$defs/Common",
          "description": "Engine-enforced common block"
        },
        "payload": {
          "additionalProperties": true,
          "description": "Backend-specific payload (fully resolved)",
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "step_n",
        "step_id",
        "backend",
        "common"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A materialized job ready for execution.\n\nProduced by: compile(job_def, envelope) -> JobInstance\n\nThe step list is fixed and never mutated by the executor.",
  "properties": {
    "job_id": {
      "description": "Job template ID this was compiled from",
      "title": "Job Id",
      "type": "string"
    },
    "job_hash": {
      "description": "Hash of this instance for deduplication",
      "title": "Job Hash",
      "type": "string"
    },
    "steps": {
      "description": "Ordered list of steps to execute",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "job_hash",
    "steps"
  ],
  "title": "JobInstance",
  "type": "object"
}
