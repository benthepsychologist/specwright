{
  "$defs": {
    "Backend": {
      "description": "Execution backend types.",
      "enum": [
        "cmd",
        "llm",
        "claude-code",
        "codex"
      ],
      "title": "Backend",
      "type": "string"
    },
    "Common": {
      "additionalProperties": false,
      "description": "Engine-enforced common block for all steps.\n\nThese fields are managed by the executor, not the backend.",
      "properties": {
        "repo_path": {
          "description": "Path to the target repository",
          "format": "path",
          "title": "Repo Path",
          "type": "string"
        },
        "branch": {
          "description": "Branch being worked on",
          "title": "Branch",
          "type": "string"
        },
        "base_commit": {
          "description": "SHA of the base commit",
          "title": "Base Commit",
          "type": "string"
        },
        "timeout_s": {
          "default": 300,
          "description": "Step timeout in seconds",
          "title": "Timeout S",
          "type": "integer"
        },
        "policy_profile": {
          "default": "default",
          "description": "Policy profile name",
          "title": "Policy Profile",
          "type": "string"
        }
      },
      "required": [
        "repo_path",
        "branch",
        "base_commit"
      ],
      "title": "Common",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fully resolved manifest for a step at dispatch time.\n\nStored at: ~/.local/local-governor/runs/{run_id}/steps/step-{step_n:03d}/manifest.yaml\n\nThe manifest is the complete, resolved input to a backend.\nAll @run.* references have been resolved at this point.",
  "properties": {
    "step_n": {
      "description": "Step number (1-indexed)",
      "minimum": 1,
      "title": "Step N",
      "type": "integer"
    },
    "step_id": {
      "description": "Unique identifier for this step",
      "title": "Step Id",
      "type": "string"
    },
    "backend": {
      "$ref": "#/$defs/Backend",
      "description": "Execution backend"
    },
    "common": {
      "$ref": "#/$defs/Common",
      "description": "Engine-enforced common block"
    },
    "payload": {
      "additionalProperties": true,
      "description": "Backend-specific payload (fully resolved, including @run.*)",
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "step_n",
    "step_id",
    "backend",
    "common",
    "payload"
  ],
  "title": "StepManifest",
  "type": "object"
}
