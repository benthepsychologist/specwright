{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specplatform.org/schemas/spec-v1.schema.json",
  "title": "Spec Markdown File",
  "description": "Schema for .md spec files. Describes YAML frontmatter and required markdown sections with phases.",
  "type": "object",
  "required": ["frontmatter", "sections"],
  "properties": {
    "frontmatter": {
      "type": "object",
      "description": "YAML frontmatter between --- delimiters at the start of the file",
      "required": ["tier", "title", "owner", "goal"],
      "properties": {
        "tier": {
          "enum": ["A", "B", "C"],
          "description": "Risk tier: A=high-risk (core systems, security), B=moderate (features, integrations), C=low-risk (docs, tests, config)"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "description": "Human-readable task/feature name"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Email or identifier of the spec owner"
        },
        "goal": {
          "type": "string",
          "minLength": 5,
          "description": "Brief description of what this spec aims to achieve"
        },
        "validated": {
          "type": "boolean",
          "default": false,
          "description": "Set to true by 'spec validate' after passing validation"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "default": "0.1",
          "description": "Spec schema version"
        },
        "labels": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Labels/tags for categorization"
        },
        "epic": {
          "type": "string",
          "description": "Epic ID this spec belongs to"
        },
        "repo": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Repository name"
            },
            "url": {
              "type": "string",
              "description": "Git repository URL"
            },
            "default_branch": {
              "type": "string",
              "default": "main"
            },
            "working_branch": {
              "type": "string",
              "description": "Feature branch for this spec (e.g., feat/my-feature)"
            }
          }
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when spec was created"
        },
        "updated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when spec was last updated"
        }
      }
    },
    "sections": {
      "type": "object",
      "description": "Required and optional markdown sections (H2 headings)",
      "required": ["objective", "acceptance_criteria", "phases"],
      "properties": {
        "header": {
          "type": "object",
          "description": "H1 title and metadata block at top of spec body",
          "properties": {
            "title": {
              "type": "string",
              "description": "# Spec Title (e.g., '# e005b-01: Executor Dispatch')"
            },
            "epic": {
              "type": "string",
              "description": "**Epic:** epic-id"
            },
            "repo": {
              "type": "string",
              "description": "**Repo:** repository-name"
            },
            "branch": {
              "type": "string",
              "description": "**Branch:** `feat/branch-name`"
            },
            "tier": {
              "type": "string",
              "description": "**Tier:** A|B|C"
            }
          }
        },
        "objective": {
          "type": "string",
          "description": "## Objective section - describes what the spec achieves and the approach"
        },
        "prior_work": {
          "type": "string",
          "description": "## Prior Work section - what already exists that this builds on (optional)"
        },
        "what_this_spec_changes": {
          "type": "string",
          "description": "## What This Spec Changes - summary of changes (optional)"
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "status": { "enum": ["pending", "done"] }
            }
          },
          "description": "## Acceptance Criteria - checkbox list: - [ ] item or - [x] item"
        },
        "context": {
          "type": "object",
          "description": "## Context section - schemas, examples, background info",
          "properties": {
            "content": {
              "type": "string",
              "description": "Free-form markdown with code examples, JSON schemas, etc."
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "## Constraints section - bullet list of limitations and rules"
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "description": "## Phase N: Title sections - implementation breakdown",
          "items": {
            "type": "object",
            "required": ["phase_number", "title", "objective"],
            "properties": {
              "phase_number": {
                "type": "integer",
                "minimum": 1,
                "description": "Phase number (## Phase N: Title)"
              },
              "title": {
                "type": "string",
                "description": "Phase title"
              },
              "objective": {
                "type": "string",
                "description": "### Objective - what this phase accomplishes"
              },
              "files_to_touch": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "action": {
                      "enum": ["create", "modify", "delete"],
                      "default": "modify"
                    }
                  }
                },
                "description": "### Files to Touch - list of files with action (create/modify)"
              },
              "implementation_notes": {
                "type": "string",
                "description": "### Implementation Notes - code examples, patterns, details"
              },
              "verification": {
                "type": "array",
                "items": { "type": "string" },
                "description": "### Verification - commands or checks to verify phase completion"
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "frontmatter": {
        "tier": "B",
        "title": "Executor Dispatch",
        "owner": "dev@example.com",
        "goal": "Refactor executor to use JSON-RPC boundaries for all callable dispatch",
        "epic": "e005b-command-plane-and-performance",
        "repo": {
          "name": "lorchestra",
          "working_branch": "feat/executor-dispatch"
        }
      },
      "sections": {
        "header": {
          "title": "# e005b-01: Executor Dispatch (JSON-RPC Boundaries)",
          "epic": "e005b-command-plane-and-performance",
          "repo": "lorchestra",
          "branch": "feat/executor-dispatch",
          "tier": "B"
        },
        "objective": "Refactor lorchestra executor to use JSON-RPC boundaries for ALL callable dispatch.",
        "acceptance_criteria": [
          { "text": "lorchestra/schemas/ops.py updated: only call.*, compute.llm, job.run ops", "status": "pending" },
          { "text": "lorchestra/rpc/ module created with envelope, adapter, hashing, registry", "status": "pending" },
          { "text": "pytest tests/ -v passes", "status": "pending" },
          { "text": "ruff check lorchestra/ passes", "status": "pending" }
        ],
        "constraints": [
          "Job language (JobInstance, StepManifest) must NOT contain JSON-RPC keys",
          "All hashes use canonical JSON (sorted keys, no whitespace)",
          "Error classification REQUIRED: transient or permanent"
        ],
        "phases": [
          {
            "phase_number": 1,
            "title": "Update Op Enum",
            "objective": "Slim down the Op enum to the thin orchestrator model.",
            "files_to_touch": [
              { "path": "lorchestra/schemas/ops.py", "action": "modify" },
              { "path": "lorchestra/schemas/ops.schema.json", "action": "modify" }
            ],
            "implementation_notes": "Remove query.*, write.*, assert.* ops. Keep only call.*, compute.llm, job.run",
            "verification": [
              "from lorchestra.schemas.ops import Op works",
              "Op.QUERY_RAW_OBJECTS raises AttributeError"
            ]
          },
          {
            "phase_number": 2,
            "title": "JSON-RPC Adapter",
            "objective": "Create the RPC module for envelope handling.",
            "files_to_touch": [
              { "path": "lorchestra/rpc/__init__.py", "action": "create" },
              { "path": "lorchestra/rpc/envelope.py", "action": "create" },
              { "path": "lorchestra/rpc/adapter.py", "action": "create" }
            ],
            "verification": [
              "from lorchestra.rpc import RpcAdapter, RpcRequest, RpcResponse"
            ]
          }
        ]
      }
    }
  ]
}
